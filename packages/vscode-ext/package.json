{
  "name": "kimix-vscode-ext",
  "publisher": "sikao-engine",
  "displayName": "KimiX Code",
  "description": "Official KimiX Code plugin for VS Code",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "assistant",
    "code",
    "chat",
    "agent",
    "mcp",
    "skills"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "KimiX Code",
      "properties": {
        "kimix.executable": {
          "type": "string",
          "default": "kimix",
          "description": "Executable name or absolute path of the opencode-compatible server CLI"
        },
        "kimix.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host the server binds to"
        },
        "kimix.basePort": {
          "type": "number",
          "default": 4096,
          "description": "Starting port for the server; the extension scans upward for a free one"
        },
        "kimix.autoFallbackPort": {
          "type": "boolean",
          "default": true,
          "description": "Automatically fall back to the next free port when the base port is occupied by a foreign process"
        },
        "kimix.environmentVariables": {
          "type": "object",
          "default": {},
          "description": "Environment variables passed to the server process",
          "additionalProperties": {
            "type": "string"
          }
        },
        "kimix.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show thinking/reasoning content in the chat UI"
        },
        "kimix.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "Auto-scroll to the bottom of the chat while the model is streaming"
        },
        "kimix.enableMentions": {
          "type": "boolean",
          "default": true,
          "description": "Enable @ file/symbol mentions in the composer"
        },
        "kimix.planModeEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the full plan-mode workflow (planner agent + review + implement)"
        },
        "kimix.planFilePath": {
          "type": "string",
          "default": ".kimix/plan.md",
          "description": "Relative path where generated plans are saved"
        },
        "kimix.planAgent": {
          "type": "string",
          "default": "",
          "description": "Agent name used for planning. Empty falls back to prompt decoration."
        },
        "kimix.planMaxAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum plan generation/revision attempts"
        },
        "kimix.openPlanFileAfterGeneration": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated plan file in the editor after planning completes"
        }
      }
    },
    "commands": [
      {
        "command": "kimix.newConversation",
        "title": "KimiX: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "kimix.openInTab",
        "title": "KimiX: Open in New Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "kimix.togglePlanMode",
        "title": "KimiX: Toggle Plan Mode"
      },
      {
        "command": "kimix.generatePlan",
        "title": "KimiX: Generate Plan"
      },
      {
        "command": "kimix.implementPlan",
        "title": "KimiX: Implement Plan"
      },
      {
        "command": "kimix.discardPlan",
        "title": "KimiX: Discard Plan"
      },
      {
        "command": "kimix.compactContext",
        "title": "KimiX: Compact Context",
        "icon": "$(fold)"
      },
      {
        "command": "kimix.restart",
        "title": "KimiX: Restart Server",
        "icon": "$(refresh)"
      },
      {
        "command": "kimix.showLogs",
        "title": "KimiX: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "kimix.startServer",
        "title": "KimiX: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "kimix.stopServer",
        "title": "KimiX: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kimix.restartServer",
        "title": "KimiX: Restart Server",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kimix-sidebar",
          "title": "KimiX",
          "icon": "resources/kimi-icon.svg"
        }
      ]
    },
    "views": {
      "kimix-sidebar": [
        {
          "type": "webview",
          "id": "kimix.webview",
          "name": "KimiX"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kimix.newConversation",
          "when": "view == kimix.webview",
          "group": "navigation@1"
        },
        {
          "command": "kimix.compactContext",
          "when": "view == kimix.webview",
          "group": "navigation@2"
        },
        {
          "command": "kimix.openInTab",
          "when": "view == kimix.webview",
          "group": "navigation@3"
        },
        {
          "command": "kimix.restart",
          "when": "view == kimix.webview",
          "group": "navigation@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build:prod",
    "clean": "rimraf dist node_modules",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode --watch --tsconfig=tsconfig.json",
    "build": "pnpm run build:webview && pnpm run build:copy-view && pnpm run build:extension",
    "build:prod": "pnpm run build:webview && pnpm run build:copy-view && pnpm run build:extension:prod",
    "build:webview": "pnpm --filter kimix-webview-ui run build",
    "build:extension": "node esbuild.js",
    "build:extension:prod": "node esbuild.js --production",
    "build:copy-view": "pnpm --filter kimix-webview-ui run copy-to-ext",
    "package": "vsce package --no-dependencies --out kimix-ext.vsix"
  },
  "devDependencies": {
    "@types/node": "~22.19.19",
    "@types/vscode": "^1.100.0",
    "@vitest/coverage-v8": "^3.1.3",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.1.3"
  }
}
